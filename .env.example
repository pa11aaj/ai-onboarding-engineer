# Copy this file to `.env` for local development. In production (e.g. a
# Vercel deployment), set these as environment variables in your hosting
# provider's dashboard instead — never commit a real `.env` file.

# =============================================================================
# Pinecone (vector store) — required for ingest.py, main.py, and server.py
# =============================================================================
PINECONE_API_KEY=

# Optional — sensible defaults are baked into agents.py if you omit these.
# PINECONE_INDEX_NAME=onboarding-engineer
# PINECONE_NAMESPACE=onboarding_docs
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_METRIC=cosine

# =============================================================================
# Embeddings — must be the SAME provider/model for both ingest.py and the
# server, or similarity search will silently return nothing useful (or
# outright fail with a dimension mismatch).
# =============================================================================
# "local" = sentence-transformers, offline, no API key, ~80MB model download.
#   Fine for local dev; avoid for a Vercel deployment (pulls in PyTorch,
#   which alone can exceed the platform's function size limit).
# "openai" = OpenAI's embeddings API — the recommended choice for a hosted
#   deployment (small, fast, no heavy dependency).
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=

# =============================================================================
# Chat model — powers the three agents' reasoning (syllabus design, lab
# generation, review). "ollama" only works where an Ollama daemon is
# reachable (i.e. local dev, not a serverless deployment).
# =============================================================================
CHAT_PROVIDER=openai
# CHAT_MODEL=gpt-4o-mini

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# =============================================================================
# Session checkpointer — see agent_service.py's module docstring for why
# this matters. "memory" is fine for `uvicorn server:app` on your own
# machine; a serverless deployment (Vercel) REQUIRES "postgres" or "redis"
# so session state survives across separate function instances.
# =============================================================================
CHECKPOINTER="memory"

# Required if CHECKPOINTER=postgres — a Neon connection string works well
# here (see NEON_SETUP.md). POSTGRES_URL is also read as a fallback, since
# some providers' Vercel integrations inject that name instead.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required if CHECKPOINTER=redis — note this needs Redis Stack / Redis
# Cloud specifically (RediSearch + RedisJSON modules); plain/serverless
# Redis offerings like Upstash are NOT compatible with this checkpointer.
# REDIS_URL=redis://default:password@host:port

# =============================================================================
# Web server (server.py)
# =============================================================================
# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,http://localhost:3000
# Defaults to "*" (allow any origin) if unset — fine for a demo, tighten
# this once you know your deployed frontend's URL.
# FRONTEND_ORIGINS=*

# =============================================================================
# Misc
# =============================================================================
# Set to DEBUG for verbose logging; anything else (or unset) is INFO.
# LOG_LEVEL=INFO